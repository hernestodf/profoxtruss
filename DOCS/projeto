// Variáveis globais
let canvas = new fabric.Canvas('canvas', {
    selection: false,
    preserveObjectStacking: true
});
let scale = 50; // 1m = 50px (padrão)
let gridEnabled = true;
let components = []; // Array para armazenar componentes no canvas
let projectName = "Projeto Sem Nome";

// Dados dos componentes (peso unitário em kg)
const componentData = {
    Q30: {
        0.30: { weight: 0.5 },
        0.50: { weight: 0.8 },
        1.00: { weight: 1.6 },
        1.50: { weight: 2.4 },
        2.00: { weight: 3.2 },
        3.00: { weight: 4.8 },
        4.00: { weight: 6.4 },
        5.00: { weight: 8.0 }
    },
    sleeve: { weight: 0.2 },
    sapata: { weight: 1.0 }
};

// Inicializa o canvas
function initCanvas() {
    canvas.clear();
    if (gridEnabled) drawGrid();
    canvas.renderAll();
}

// Desenha grade no canvas
function drawGrid() {
    const gridSize = 20; // Tamanho da grade em pixels
    const width = canvas.width;
    const height = canvas.height;

    for (let i = 0; i < width; i += gridSize) {
        canvas.add(new fabric.Line([i, 0, i, height], {
            stroke: '#eee',
            selectable: false,
            evented: false
        }));
    }
    for (let i = 0; i < height; i += gridSize) {
        canvas.add(new fabric.Line([0, i, width, i], {
            stroke: '#eee',
            selectable: false,
            evented: false
        }));
    }
}

// Adiciona um componente ao canvas
function addComponent(type, length, x, y) {
    let obj;
    if (type === 'Q30') {
        obj = new fabric.Rect({
            left: x,
            top: y,
            fill: '#4CAF50',
            width: length * scale,
            height: 10,
            originX: 'center',
            originY: 'center',
            hasControls: true,
            hasRotatingControl: true,
            lockRotation: false,
            data: { type, length }
        });
    } else if (type === 'sleeve') {
        obj = new fabric.Circle({
            left: x,
            top: y,
            fill: '#FF5722',
            radius: 10,
            originX: 'center',
            originY: 'center',
            hasControls: true,
            hasRotatingControl: true,
            data: { type }
        });
    } else if (type === 'sapata') {
        obj = new fabric.Rect({
            left: x,
            top: y,
            fill: '#2196F3',
            width: 20,
            height: 20,
            originX: 'center',
            originY: 'center',
            hasControls: true,
            hasRotatingControl: true,
            data: { type }
        });
    }

    obj.on('modified', () => {
        updateQuantitativo();
    });

    canvas.add(obj);
    components.push(obj);
    updateQuantitativo();
}

// Atualiza a tabela de quantitativo
function updateQuantitativo() {
    const quantitativo = {
        Q30: {},
        sleeve: 0,
        sapata: 0
    };
    let totalWeight = 0;

    components.forEach(comp => {
        const data = comp.data;
        if (data.type === 'Q30') {
            if (!quantitativo.Q30[data.length]) {
                quantitativo.Q30[data.length] = 0;
            }
            quantitativo.Q30[data.length]++;
            totalWeight += componentData.Q30[data.length].weight;
        } else if (data.type === 'sleeve') {
            quantitativo.sleeve++;
            totalWeight += componentData.sleeve.weight;
        } else if (data.type === 'sapata') {
            quantitativo.sapata++;
            totalWeight += componentData.sapata.weight;
        }
    });

    // Atualiza a tabela HTML
    const tableBody = document.getElementById('quantitativoTable');
    tableBody.innerHTML = '';

    for (const length in quantitativo.Q30) {
        const qtd = quantitativo.Q30[length];
        const weight = componentData.Q30[length].weight * qtd;
        tableBody.innerHTML += `
            <tr>
                <td>Q30</td>
                <td>${length}m</td>
                <td>${qtd}</td>
                <td>${weight.toFixed(2)}</td>
            </tr>
        `;
    }

    if (quantitativo.sleeve > 0) {
        const weight = componentData.sleeve.weight * quantitativo.sleeve;
        tableBody.innerHTML += `
            <tr>
                <td>Sleeve</td>
                <td>-</td>
                <td>${quantitativo.sleeve}</td>
                <td>${weight.toFixed(2)}</td>
            </tr>
        `;
    }

    if (quantitativo.sapata > 0) {
        const weight = componentData.sapata.weight * quantitativo.sapata;
        tableBody.innerHTML += `
            <tr>
                <td>Sapata</td>
                <td>-</td>
                <td>${quantitativo.sapata}</td>
                <td>${weight.toFixed(2)}</td>
            </tr>
        `;
    }

    document.getElementById('totalWeight').textContent = `${totalWeight.toFixed(2)} kg`;
}

// Gera layout automático com base nas dimensões
function generateAutoLayout() {
    const width = parseFloat(document.getElementById('width').value) || 0;
    const height = parseFloat(document.getElementById('height').value) || 0;
    const length = parseFloat(document.getElementById('length').value) || 0;

    if (width <= 0 || height <= 0 || length <= 0) {
        alert("Por favor, insira dimensões válidas.");
        return;
    }

    // Limpa o canvas
    canvas.clear();
    components = [];

    // Adiciona barras longitudinais (topo e base)
    const longitudinalLength = length;
    const qtdLongitudinal = 2; // Topo e base
    for (let i = 0; i < qtdLongitudinal; i++) {
        const y = i === 0 ? height * scale / 2 : height * scale / 2 + height * scale;
        addComponent('Q30', longitudinalLength, longitudinalLength * scale / 2, y);
    }

    // Adiciona barras verticais (a cada 1m)
    const verticalSpacing = 1.0; // 1m entre barras verticais
    const qtdVertical = Math.floor(length / verticalSpacing) + 1;
    for (let i = 0; i < qtdVertical; i++) {
        const x = i * verticalSpacing * scale;
        addComponent('Q30', height, x, height * scale / 2 + height * scale / 2);
    }

    // Adiciona diagonais (a cada 1m)
    for (let i = 0; i < qtdVertical - 1; i++) {
        const x1 = i * verticalSpacing * scale;
        const x2 = (i + 1) * verticalSpacing * scale;
        const y1 = height * scale / 2 + height * scale;
        const y2 = height * scale / 2;
        const diagonalLength = Math.sqrt(Math.pow(verticalSpacing, 2) + Math.pow(height, 2));
        addComponent('Q30', diagonalLength, (x1 + x2) / 2, (y1 + y2) / 2);
    }

    // Adiciona sapatas (4 cantos)
    addComponent('sapata', null, 0, height * scale / 2 + height * scale);
    addComponent('sapata', null, length * scale, height * scale / 2 + height * scale);
    addComponent('sapata', null, 0, height * scale / 2);
    addComponent('sapata', null, length * scale, height * scale / 2);

    // Adiciona sleeves (nas conexões)
    for (let i = 0; i < qtdVertical; i++) {
        const x = i * verticalSpacing * scale;
        addComponent('sleeve', null, x, height * scale / 2 + height * scale);
        addComponent('sleeve', null, x, height * scale / 2);
    }

    updateQuantitativo();
}

// Exporta para PDF
function exportToPDF() {
    const { jsPDF } = window.jspdf;
    const doc = new jsPDF();

    // Página 1: Desenho da estrutura
    const canvasData = canvas.toDataURL({ format: 'png', quality: 0.8 });
    doc.addImage(canvasData, 'PNG', 10, 10, 180, 100);

    // Página 2: Tabela de quantitativo
    doc.addPage();
    doc.setFontSize(16);
    doc.text("Quantitativo de Materiais", 10, 20);

    const tableData = [];
    const tableHeaders = [["Componente", "Tamanho", "Qtd.", "Peso (kg)"]];

    const quantitativo = {
        Q30: {},
        sleeve: 0,
        sapata: 0
    };
    let totalWeight = 0;

    components.forEach(comp => {
        const data = comp.data;
        if (data.type === 'Q30') {
            if (!quantitativo.Q30[data.length]) {
                quantitativo.Q30[data.length] = 0;
            }
            quantitativo.Q30[data.length]++;
            totalWeight += componentData.Q30[data.length].weight;
        } else if (data.type === 'sleeve') {
            quantitativo.sleeve++;
            totalWeight += componentData.sleeve.weight;
        } else if (data.type === 'sapata') {
            quantitativo.sapata++;
            totalWeight += componentData.sapata.weight;
        }
    });

    for (const length in quantitativo.Q30) {
        const qtd = quantitativo.Q30[length];
        const weight = componentData.Q30[length].weight * qtd;
        tableData.push([`Q30 (${length}m)`, "", qtd, weight.toFixed(2)]);
    }

    if (quantitativo.sleeve > 0) {
        const weight = componentData.sleeve.weight * quantitativo.sleeve;
        tableData.push(["Sleeve", "", quantitativo.sleeve, weight.toFixed(2)]);
    }

    if (quantitativo.sapata > 0) {
        const weight = componentData.sapata.weight * quantitativo.sapata;
        tableData.push(["Sapata", "", quantitativo.sapata, weight.toFixed(2)]);
    }

    tableData.push(["Total", "", "", totalWeight.toFixed(2)]);

    doc.autoTable({
        head: tableHeaders,
        body: tableData,
        startY: 30
    });

    doc.save(`box_truss_${projectName}.pdf`);
}

// Exporta para Excel
function exportToExcel() {
    const wb = XLSX.utils.book_new();
    const ws = XLSX.utils.json_to_sheet([]);

    // Adiciona cabeçalho
    XLSX.utils.sheet_add_aoa(ws, [["Componente", "Tamanho", "Quantidade", "Peso Unitário (kg)", "Peso Total (kg)"]], { origin: "A1" });

    // Adiciona dados
    const quantitativo = {
        Q30: {},
        sleeve: 0,
        sapata: 0
    };
    let totalWeight = 0;
    let row = 2;

    components.forEach(comp => {
        const data = comp.data;
        if (data.type === 'Q30') {
            if (!quantitativo.Q30[data.length]) {
                quantitativo.Q30[data.length] = 0;
            }
            quantitativo.Q30[data.length]++;
        } else if (data.type === 'sleeve') {
            quantitativo.sleeve++;
        } else if (data.type === 'sapata') {
            quantitativo.sapata++;
        }
    });

    for (const length in quantitativo.Q30) {
        const qtd = quantitativo.Q30[length];
        const unitWeight = componentData.Q30[length].weight;
        const total = unitWeight * qtd;
        totalWeight += total;
        XLSX.utils.sheet_add_aoa(ws, [[`Q30 (${length}m)`, "", qtd, unitWeight, total.toFixed(2)]], { origin: { r: row, c: 0 } });
        row++;
    }

    if (quantitativo.sleeve > 0) {
        const unitWeight = componentData.sleeve.weight;
        const total = unitWeight * quantitativo.sleeve;
        totalWeight += total;
        XLSX.utils.sheet_add_aoa(ws, [["Sleeve", "", quantitativo.sleeve, unitWeight, total.toFixed(2)]], { origin: { r: row, c: 0 } });
        row++;
    }

    if (quantitativo.sapata > 0) {
        const unitWeight = componentData.sapata.weight;
        const total = unitWeight * quantitativo.sapata;
        totalWeight += total;
        XLSX.utils.sheet_add_aoa(ws, [["Sapata", "", quantitativo.sapata, unitWeight, total.toFixed(2)]], { origin: { r: row, c: 0 } });
        row++;
    }

    // Adiciona total
    XLSX.utils.sheet_add_aoa(ws, [["Total", "", "", "", totalWeight.toFixed(2)]], { origin: { r: row, c: 0 } });

    // Adiciona a planilha ao workbook
    XLSX.utils.book_append_sheet(wb, ws, "Quantitativo");

    // Exporta o arquivo
    XLSX.writeFile(wb, `box_truss_${projectName}.xlsx`);
}

// Salva o projeto no backend
function saveProject() {
    const width = document.getElementById('width').value;
    const height = document.getElementById('height').value;
    const length = document.getElementById('length').value;
    const scale = document.getElementById('scaleSelector').value;

    // Serializa os componentes
    const componentsData = components.map(comp => ({
        type: comp.data.type,
        length: comp.data.length,
        x: comp.left,
        y: comp.top,
        rotation: comp.angle,
        width: comp.width,
        height: comp.height
    }));

    // Dados para enviar ao backend
    const projectData = {
        name: projectName || "Projeto Sem Nome",
        width,
        height,
        length,
        scale,
        components: JSON.stringify(componentsData)
    };

    // Envia para o backend via AJAX
    fetch('save_project.php', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json'
        },
        body: JSON.stringify(projectData)
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            alert("Projeto salvo com sucesso!");
            loadProjects(); // Recarrega a lista de projetos
        } else {
            alert("Erro ao salvar projeto: " + data.message);
        }
    })
    .catch(error => {
        console.error("Erro:", error);
        alert("Erro ao salvar projeto.");
    });
}

// Carrega a lista de projetos
function loadProjects() {
    fetch('load_project.php')
    .then(response => response.json())
    .then(data => {
