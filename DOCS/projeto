// Carrega um projeto específico
function loadProject(projectId) {
    fetch(`load_project.php?id=${projectId}`)
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            const project = data.project;
            document.getElementById('width').value = project.width;
            document.getElementById('height').value = project.height;
            document.getElementById('length').value = project.length;
            document.getElementById('scaleSelector').value = project.scale;
            scale = parseInt(project.scale);

            // Limpa o canvas
            canvas.clear();
            components = [];

            // Carrega os componentes
            const componentsData = JSON.parse(project.components);
            componentsData.forEach(comp => {
                if (comp.type === 'Q30') {
                    addComponent(comp.type, comp.length, comp.x, comp.y);
                    const obj = components[components.length - 1];
                    obj.set({ angle: comp.rotation });
                    obj.setCoords();
                } else {
                    addComponent(comp.type, null, comp.x, comp.y);
                    const obj = components[components.length - 1];
                    obj.set({ angle: comp.rotation });
                    obj.setCoords();
                }
            });

            canvas.renderAll();
            updateQuantitativo();
            document.getElementById('currentScale').textContent = `1m = ${scale}px`;
            bootstrap.Modal.getInstance(document.getElementById('projectModal')).hide();
        } else {
            alert("Erro ao carregar projeto: " + data.message);
        }
    })
    .catch(error => {
        console.error("Erro:", error);
        alert("Erro ao carregar projeto.");
    });
}

// Exclui um projeto
function deleteProject(projectId) {
    fetch(`delete_project.php?id=${projectId}`)
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            alert("Projeto excluído com sucesso!");
            loadProjects();
        } else {
            alert("Erro ao excluir projeto: " + data.message);
        }
    })
    .catch(error => {
        console.error("Erro:", error);
        alert("Erro ao excluir projeto.");
    });
}

