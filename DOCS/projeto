        initCanvas();
    });

    // Botão de limpar
    document.getElementById('clearCanvas').addEventListener('click', () => {
        canvas.clear();
        components = [];
        initCanvas();
        updateQuantitativo();
    });

    // Botão de calcular
    document.getElementById('calculate').addEventListener('click', updateQuantitativo);

    // Botão de layout automático
    document.getElementById('autoLayout').addEventListener('click', generateAutoLayout);

    // Botão de salvar
    document.getElementById('saveProject').addEventListener('click', () => {
        projectName = prompt("Digite o nome do projeto:", projectName || "Projeto Sem Nome");
        if (projectName) {
            saveProject();
        }
    });

    // Botão de carregar
    document.getElementById('loadProject').addEventListener('click', () => {
        loadProjects();
        const modal = new bootstrap.Modal(document.getElementById('projectModal'));
        modal.show();
    });

    // Botão de exportar PDF
    document.getElementById('exportPDF').addEventListener('click', exportToPDF);

    // Botão de exportar Excel
    document.getElementById('exportExcel').addEventListener('click', exportToExcel);

    // Eventos de drag-and-drop
    document.querySelectorAll('.component-btn').forEach(btn => {
        btn.addEventListener('dragstart', (e) => {
            e.dataTransfer.setData('text/plain', JSON.stringify({
                type: btn.dataset.type,
                length: btn.dataset.length ? parseFloat(btn.dataset.length) : null
            }));
        });
    });

    canvas.addEventListener('dragover', (e) => {
        e.preventDefault();
    });

    canvas.addEventListener('drop', (e) => {
        e.preventDefault();
        const data = JSON.parse(e.dataTransfer.getData('text/plain'));
        const rect = canvas.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        addComponent(data.type, data.length, x, y);
    });

    // Carrega projetos ao abrir o modal
    loadProjects();
});




